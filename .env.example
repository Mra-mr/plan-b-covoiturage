# Copiez ce fichier en .env — jamais de secret commité dans Git.
# Seules les clés publiques (publishable / anon) ont leur place dans une app mobile :
# le code d'une app est lisible par n'importe qui. La sécurité repose sur les
# politiques RLS de Supabase, pas sur le secret de la clé.
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
